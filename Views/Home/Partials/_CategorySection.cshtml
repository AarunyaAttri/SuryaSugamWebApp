@model IReadOnlyList<WebApplication2.Models.CategoryCard>

<section class="section category-section" id="categories">
    <div class="section-heading">
        <div><p class="eyebrow"><span data-en="Fresh from SuryaSugam Bakery" data-hi="सूर्यसुगम बेकरी से ताज़ा">Fresh from SuryaSugam Bakery</span></p><h2><span data-en="Choose your favourite." data-hi="अपना पसंदीदा चुनें।">Choose your favourite.</span></h2></div>
        <p class="section-intro"><span data-en="Fresh Fans, CreamRoll, and Toast for every tea break." data-hi="हर चाय के साथ ताज़ा फैन, क्रीम रोल और टोस्ट।">Fresh Fans, CreamRoll, and Toast for every tea break.</span></p>
    </div>
    <div class="category-grid">
        @foreach (var category in Model)
        {
            <a class="category-card" href="@category.Url" aria-label="@category.Name" data-en-aria-label="@category.Name" data-hi-aria-label="@category.NameHindi">
                <div class="category-image"><img src="@category.ImageUrl" alt="@category.Name" data-en-alt="@category.Name" data-hi-alt="@category.NameHindi" loading="lazy" />
                    @if (!string.IsNullOrWhiteSpace(category.Badge)) { <span class="card-badge" data-en="@category.Badge" data-hi="@category.BadgeHindi">@category.Badge</span> }
                    <span class="category-arrow" aria-hidden="true">↗</span>
                </div>
                <div class="category-copy"><div><h3><span data-en="@category.Name" data-hi="@category.NameHindi">@category.Name</span></h3><p><span data-en="@category.Description" data-hi="@category.DescriptionHindi">@category.Description</span></p></div><span aria-hidden="true">→</span></div>
            </a>
        }
    </div>
</section>
