@model ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    var cartMessage = TempData["CartMessage"] as string;
    var categoryAnchor = $"/#{Model.Category.ToLowerInvariant()}";
    var productMessage = System.Uri.EscapeDataString($"Namaste SuryaSugam Bakery, I would like to order {Model.Product.Name} ({Model.Product.Price}).");
}

<div class="product-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-controller="Home" asp-action="Index" data-en="Home" data-hi="होम">Home</a><span>/</span><a href="@categoryAnchor"><span data-en="@Model.Category" data-hi="@Model.CategoryHindi">@Model.Category</span></a><span>/</span><span aria-current="page" data-en="@Model.Product.Name" data-hi="@Model.Product.NameHindi">@Model.Product.Name</span></nav>
    @if (!string.IsNullOrWhiteSpace(cartMessage))
    {
        <p class="cart-message" role="status">@cartMessage</p>
    }
    <div class="product-detail-grid">
        <div class="product-detail-gallery">
            <div class="product-detail-image"><img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" data-en-alt="@Model.Product.Name" data-hi-alt="@Model.Product.NameHindi" fetchpriority="high" /><span class="product-image-brand" aria-hidden="true"><img src="~/images/surya-sugam-bakery-logo.svg" alt="" /></span><span class="detail-badge" data-en="Freshly made" data-hi="ताज़ा तैयार">Freshly made</span></div>
            <p class="gallery-caption"><span data-en="Small batch · Made with care" data-hi="छोटी मात्रा में · प्यार से तैयार">Small batch · Made with care</span><span>01 / 01</span></p>
        </div>
        <section class="product-detail-info" aria-labelledby="product-title">
            <p class="eyebrow"><span data-en="@Model.Category" data-hi="@Model.CategoryHindi">@Model.Category</span></p>
            <h1 id="product-title"><span data-en="@Model.Product.Name" data-hi="@Model.Product.NameHindi">@Model.Product.Name</span></h1>
            <p class="product-detail-subtitle"><span data-en="@Model.Product.Description" data-hi="@Model.Product.DescriptionHindi">@Model.Product.Description</span></p>
            <p class="product-detail-price">@Model.Product.Price <span data-en="Taxes included" data-hi="कर शामिल">Taxes included</span></p>
            <p class="detail-delivery-note"><span aria-hidden="true">✳</span> <span data-en="Freshly prepared for your selected delivery date" data-hi="आपकी चुनी हुई डिलीवरी तारीख के लिए ताज़ा तैयार">Freshly prepared for your selected delivery date</span></p>

            <form asp-controller="Home" asp-action="AddToCart" asp-route-slug="@Model.Product.Slug" method="post" class="product-order-form">
                <div asp-validation-summary="ModelOnly" class="order-validation"></div>
                <div class="option-field">
                    <label asp-for="Order.Size"><span data-en="Size" data-hi="पैक का आकार">Size</span> <span>*</span></label>
                    <select asp-for="Order.Size">
                        @foreach (var size in Model.SizeOptions)
                        {
                            var sizeHindi = size switch { "Pack of 2" => "2 का पैक", "Pack of 4" => "4 का पैक", "Pack of 8" => "8 का पैक", "1 piece" => "1 पीस", "Box of 4" => "4 का बॉक्स", "Box of 6" => "6 का बॉक्स", "200 g" => "200 ग्राम", "400 g" => "400 ग्राम", "800 g" => "800 ग्राम", _ => size };
                            <option value="@size" data-en="@size" data-hi="@sizeHindi">@size</option>
                        }
                    </select>
                    <span asp-validation-for="Order.Size" class="field-error"></span>
                </div>
                <div class="option-field">
                    <label asp-for="Order.EggOption"><span data-en="Preference" data-hi="विकल्प">Preference</span> <span>*</span></label>
                    <select asp-for="Order.EggOption">
                        @foreach (var option in Model.EggOptions)
                        {
                            var optionHindi = option == "Eggless" ? "अंडे रहित" : "सामान्य";
                            <option value="@option" data-en="@option" data-hi="@optionHindi">@option</option>
                        }
                    </select>
                    <span asp-validation-for="Order.EggOption" class="field-error"></span>
                </div>
                <div class="option-field message-field">
                    <label asp-for="Order.Message"><span data-en="Message for the baker" data-hi="बेकरी के लिए संदेश">Message for the baker</span> <small data-en="Optional · 40 characters" data-hi="वैकल्पिक · 40 अक्षर">Optional · 40 characters</small></label>
                    <input asp-for="Order.Message" maxlength="40" placeholder="Add a little note" data-en-placeholder="Add a little note" data-hi-placeholder="छोटा सा संदेश लिखें" data-message-input />
                    <div class="input-meta"><span asp-validation-for="Order.Message" class="field-error"></span><span><span data-message-count>0</span>/40</span></div>
                </div>
                <fieldset class="delivery-fields">
                    <legend><span data-en="Delivery details" data-hi="डिलीवरी की जानकारी">Delivery details</span> <span>*</span></legend>
                    <p class="delivery-fields-intro" data-en="Choose where and when your fresh bake should arrive." data-hi="बताएँ कि आपका ऑर्डर कहाँ और कब पहुँचाना है।">Choose where and when your fresh bake should arrive.</p>
                    <div class="delivery-grid">
                        <div class="option-field"><label asp-for="Order.City" data-en="City" data-hi="शहर">City</label><select asp-for="Order.City"><option value="" data-en="Select city" data-hi="शहर चुनें">Select city</option><option>Mathura</option></select><span asp-validation-for="Order.City" class="field-error"></span></div>
                        <div class="option-field"><label asp-for="Order.Area" data-en="Area" data-hi="इलाका">Area</label><input asp-for="Order.Area" placeholder="Gomati Vihar, Lohaban Bagihi" data-en-placeholder="Gomati Vihar, Lohaban Bagihi" data-hi-placeholder="गोमती विहार, लोहेवन बागीची" /><span asp-validation-for="Order.Area" class="field-error"></span></div>
                        <div class="option-field"><label asp-for="Order.DeliveryDate" data-en="Delivery date" data-hi="डिलीवरी की तारीख">Delivery date</label><input asp-for="Order.DeliveryDate" type="date" min="@WebApplication2.Controllers.HomeController.GetBakeryToday().ToString("yyyy-MM-dd")" /><span asp-validation-for="Order.DeliveryDate" class="field-error"></span></div>
                        <div class="option-field"><label asp-for="Order.TimeSlot" data-en="Time slot" data-hi="समय चुनें">Time slot</label><select asp-for="Order.TimeSlot"><option value="" data-en="Select time" data-hi="समय चुनें">Select time</option>@foreach (var slot in Model.TimeSlots) { <option value="@slot">@slot</option> }</select><span asp-validation-for="Order.TimeSlot" class="field-error"></span></div>
                    </div>
                </fieldset>
                <div class="quantity-and-submit">
                    <div class="quantity-control" aria-label="Quantity" data-en-aria-label="Quantity" data-hi-aria-label="मात्रा"><button type="button" data-quantity-step="-1" aria-label="Decrease quantity" data-en-aria-label="Decrease quantity" data-hi-aria-label="मात्रा घटाएँ">−</button><input asp-for="Order.Quantity" inputmode="numeric" min="1" max="20" aria-label="Quantity" data-en-aria-label="Quantity" data-hi-aria-label="मात्रा" data-quantity-input /><button type="button" data-quantity-step="1" aria-label="Increase quantity" data-en-aria-label="Increase quantity" data-hi-aria-label="मात्रा बढ़ाएँ">+</button></div>
                    <button class="button button-dark add-to-cart-button" type="submit"><span data-en="Add to cart" data-hi="कार्ट में जोड़ें">Add to cart</span> <span aria-hidden="true">↗</span></button>
                </div>
                <span asp-validation-for="Order.Quantity" class="field-error"></span>
                <a class="whatsapp-order-button detail-whatsapp-button" href="https://wa.me/918921986080?text=@productMessage" target="_blank" rel="noopener noreferrer" data-wa-product data-wa-detail data-product-en="@Model.Product.Name" data-product-hi="@Model.Product.NameHindi" data-product-price="@Model.Product.Price" aria-label="Order @Model.Product.Name on WhatsApp">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 11.8a8.2 8.2 0 0 1-12.2 7.1L3 20l1.2-4.5a8.2 8.2 0 1 1 16-3.7Z" /><path d="M8.8 8.1c.2-.5.4-.5.7-.5h.5c.2 0 .4.1.5.4l.7 1.7c.1.2 0 .4-.1.6l-.5.6c-.2.2-.2.4 0 .6.4.7 1 1.3 1.8 1.7.2.1.4.1.6-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.2.4.4 0 .3-.2 1.1-.7 1.4-.5.4-1.1.5-1.8.3-1.1-.3-2.4-1-3.5-2.1-1-.9-1.7-2.1-2-3.1-.2-.7-.1-1.4.3-1.9Z" /></svg>
                    <span data-en="Order on WhatsApp" data-hi="व्हाट्सऐप पर ऑर्डर करें">Order on WhatsApp</span>
                </a>
                <p class="form-footnote"><span data-en="Prefer to call?" data-hi="फ़ोन करें:">Prefer to call?</span> <a href="tel:+918921986080">8921 986 080</a></p>
            </form>
        </section>
    </div>

    <section class="product-promises" aria-label="Our bakery promises" data-en-aria-label="Our bakery promises" data-hi-aria-label="हमारे वादे"><div><span aria-hidden="true">✳</span><strong data-en="Freshly baked" data-hi="ताज़ा बेक किया हुआ">Freshly baked</strong><small data-en="Prepared in small batches" data-hi="छोटी मात्रा में तैयार">Prepared in small batches</small></div><div><span aria-hidden="true">♡</span><strong data-en="Made with care" data-hi="प्यार से तैयार">Made with care</strong><small data-en="Thoughtful ingredients" data-hi="अच्छी सामग्री">Thoughtful ingredients</small></div><div><span aria-hidden="true">⌂</span><strong data-en="Local delivery" data-hi="स्थानीय डिलीवरी">Local delivery</strong><small data-en="Choose a time that suits" data-hi="अपना समय चुनें">Choose a time that suits</small></div><div><span aria-hidden="true">♧</span><strong data-en="Here to help" data-hi="हम मदद के लिए हैं">Here to help</strong><small data-en="Friendly bakery support" data-hi="बेकरी सहायता उपलब्ध">Friendly bakery support</small></div></section>

    <section class="product-information">
        <div class="product-information-heading"><p class="eyebrow" data-en="The good stuff" data-hi="खास जानकारी">The good stuff</p><h2><span data-en="A little more" data-hi="थोड़ी और">A little more</span> <em data-en="about your order." data-hi="आपके ऑर्डर के बारे में।">about your order.</em></h2></div>
        <div class="product-accordions">
            <details open><summary><span data-en="Product details" data-hi="उत्पाद की जानकारी">Product details</span><span aria-hidden="true">+</span></summary><p><span data-en="@Model.Description" data-hi="@Model.DescriptionHindi">@Model.Description</span></p></details>
            <details><summary><span data-en="Delivery & freshness" data-hi="डिलीवरी और ताज़गी">Delivery &amp; freshness</span><span aria-hidden="true">+</span></summary><p data-en="We prepare orders fresh and deliver in Mathura. Choose your neighbourhood, date, and available time above." data-hi="हम ऑर्डर ताज़ा तैयार करके मथुरा में पहुँचाते हैं। ऊपर अपना इलाका, तारीख और समय चुनें।">We prepare orders fresh and deliver in Mathura. Choose your neighbourhood, date, and available time above.</p></details>
            <details><summary><span data-en="Storage & care" data-hi="रखने का तरीका">Storage &amp; care</span><span aria-hidden="true">+</span></summary><p data-en="@Model.CareInstructions" data-hi="इसे डिलीवरी वाले दिन ताज़ा खाएँ। एयरटाइट डिब्बे में रखें और सीधी धूप से बचाएँ।">@Model.CareInstructions</p></details>
            <details open><summary><span data-en="Customer reviews" data-hi="ग्राहकों की राय">Customer reviews</span><span aria-hidden="true">+</span></summary>
                <div class="product-comments" data-product-comments data-product-slug="@Model.Product.Slug" data-list-url="/products/@Model.Product.Slug/comments" data-live-url="/products/@Model.Product.Slug/comments/live">
                    <p class="product-comments-status" data-comments-status role="status" aria-live="polite" data-en="Loading customer comments…" data-hi="ग्राहकों की टिप्पणियाँ लोड हो रही हैं…">Loading customer comments…</p>
                    <ul class="product-comment-list" data-comment-list aria-label="Customer comments" data-en-aria-label="Customer comments" data-hi-aria-label="ग्राहकों की टिप्पणियाँ"></ul>
                    <form class="product-comment-form" data-comment-form>
                        <div class="option-field"><label for="comment-customer-name" data-en="Your name" data-hi="आपका नाम">Your name</label><input id="comment-customer-name" name="customerName" maxlength="60" required autocomplete="name" /></div>
                        <div class="option-field"><label for="comment-text" data-en="Your comment" data-hi="आपकी टिप्पणी">Your comment</label><textarea id="comment-text" name="text" maxlength="500" rows="3" required></textarea></div>
                        <button class="button button-dark" type="submit" data-en="Share comment" data-hi="टिप्पणी साझा करें">Share comment</button>
                    </form>
                </div>
            </details>
        </div>

@section Scripts {
    <script src="~/js/product-comments.js" asp-append-version="true"></script>
}
    </section>
    <div class="continue-shopping"><a class="text-link" asp-controller="Home" asp-action="Index"><span aria-hidden="true">←</span> <span data-en="Continue exploring" data-hi="और देखें">Continue exploring</span></a></div>
</div>
